# ModelLens environment configuration
# Copy to `.env` and fill in real values. NEVER commit a real .env file.

# --- Application ---
APP_ENV=local
LOG_LEVEL=INFO

# --- Database ---
# Local docker-compose default. Override for managed Postgres.
DATABASE_URL=postgresql+psycopg://modellens:modellens@localhost:5432/modellens

# --- LLM provider ---
# Provider: "fake" (deterministic, no API key, used in tests/CI),
#           "openai", or "anthropic".
LLM_PROVIDER=fake
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Evaluation thresholds ---
FAITHFULNESS_THRESHOLD=0.85
COVERAGE_THRESHOLD=0.75
READABILITY_MAX_GRADE=12.0
MAX_REWRITE_RETRIES=2
